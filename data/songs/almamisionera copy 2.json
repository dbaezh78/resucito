      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Señor, toma mi vida nueva, (Fa,,0)(Do,7,60)(Re,m,200)",
      "sC": "tc"
    },
    {
      "line": "antes de que la espera (Si,7,15)(Fa,,161)",
      "sC": ""
    },
    {
      "line": "desgaste años en mí. (Do,,157)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Estoy, dispuesto a lo que quieras, (Fa,,12)(Do,,84)(Re,m,125)",
      "sC": ""
    },
    {
      "line": "no importa lo que sea, (Si,7,11)(Fa,,211)",
      "sC": ""
    },
    {
      "line": "Tú llámame a servir. (Do,,12)(Fa,,264)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "LLÉVAME DONDE LOS HOMBRES, (Fa,,12)(Do,,229)",
      "sC": "ta as"
    },
    {
      "line": "NECESITEN TUS PALABRAS, (Re,m,40)(Si,7,180)",
      "sC": "as"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "NECESITEN MIS GANAS DE VIVIR. (Fa,,12)(Do,,137)",
      "sC": "as"
    },
    {
      "line": "DONDE FALTE LA ESPERANZA, (Fa,,12)(Do,,147)",
      "sC": "as"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "DONDE FALTE LA ALEGRÍA, SIMPLEMENTE,, (Re,m,12)(Si,7,219)(Fa,,183)(Do,,200)",
      "sC": "as"
    },
    {
      "line": "POR NO SABER DE TI. (Fa,,15)",
      "sC": "as"
    }
  ],
  "lder": [
    {
      "line": "Te doy, mi corazón sincero, (Fa,,12)(Do,7,127)(Re,m,181)",
      "sC": "tc"
    },
    {
      "line": "para gritar sin miedo (Si,7,137)(Fa,,229)",
      "sC": ""
    },
    {
      "line": "tu grandeza Señor. (Do,,309)",
      "sC": ""
    },
    {
      "line": "Tendré, mis manos sin cansancio. (Fa,,12)(Do,,87)(Re,m,181)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Tu historia entre mis labios, (Si,7,12)(Fa,,150)",
      "sC": ""
    },
    {
      "line": "y fuerza en la oración. (Do,,0)(Fa,,150)",
      "sC": ""
    },


