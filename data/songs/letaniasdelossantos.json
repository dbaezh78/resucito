    {
      "line": "​         \"              \" ",
      "sC": "stp"
    },
    {
      "line": "Por el envío del Espíritu Santo. ",
      "sC": "mt-20"
    },
    {
      "line": "​         \"              \" ",
      "sC": "stp"
