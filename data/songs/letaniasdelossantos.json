    },
    {
      "line": "",
      "sC": ""
    },
    {
      "line": "Muéstrate propicio., (Sol,,0)(Mi,m,125)",
      "sC": ""
    },
    {
      "line": "LÍBRANOS, SEÑOR., (Do,,0)(Re,7,120)",
      "sC": "ta as stp"
    },
    {
      "line": "De todo mal. ",
      "sC": "mt-20"
    },
    {
      "line": "​         \"              \" ",
      "sC": "stp"
    },
    {
      "line": "De todo pecado. ",
      "sC": "mt-20"
    },
    {
      "line": "​         \"              \" ",
      "sC": "stp"
    },
    {
      "line": "De la muerte eterna. ",
      "sC": "mt-20"
    },
    {
      "line": "​         \"              \" ",
      "sC": "stp"
    },
    {
      "line": "Por tu encarnación. ",
      "sC": "mt-20"
    },
    {
      "line": "​         \"              \" ",
      "sC": "stp"
    },
    {
      "line": "Por tu muerte y resurrección. ",
