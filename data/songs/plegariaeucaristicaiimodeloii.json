  "lizq": [
    {
      "line": "El Señor esté con vosotros., (La,m,0)(Sol,,105)(La,m,200)",
      "sC": "pa"
    },
    {
      "line": "Y CON TU ESPÍRITU., (Sol,,25)(La,m,105)",
      "sC": "ta as"
    },
    {
      "line": "Levantemos el corazón., (Sol,,180)",
      "sC": "pa"
    },
    {
      "line": "LO TENEMOS LEVANTADO HACIA EL SEÑOR., (La,m,320)",
      "sC": "ta as"
    },
    {
      "line": "Demos gracias al Señor, nuestro Dios., (Sol,,0)(La,m,320)",
      "sC": "pa"
    },
    {
      "line": "ES JUSTO Y NECESARIO., (Sol,,0)(La,m,150)",
      "sC": "ta as"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Verdaderamente,, (La,m,0)",
      "sC": "pa asterisco"
    },
    {
      "line": "es justo y necesario,, (Sol,,30)",
      "sC": ""
    },
    {
      "line": "es nuestro deber y fuente de salvación, (La,m,340)",
      "sC": ""
    },
    {
      "line": "darte gracias, siempre y en todo lugar., (Sol,,0)(La,m,150)",
      "sC": ""
    },
    {
      "line": "A ti, Padre Santo,, ",
      "sC": "asterisco"
    },
    {
      "line": "por Jesucristo, tu amadísimo Hijo., (Sol,,185)(La,m,290)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Por Él, que es tu Palabra viviente,, (Sol,,285)",
      "sC": "astx1"
    },
    {
      "line": "hiciste todas las cosas;, (La,m,175)",
      "sC": ""
    },
    {
      "line": "tú nos lo enviaste Salvador y Redentor, (Fa,,130)(La,m,190)",
      "sC": ""
    },
    {
      "line": "hecho hombre por obra del Espíritu Santo,, (Sol,,0)",
      "sC": ""
    },
    {
      "line": "y nacido de la Virgen María,, (La,m,230)",
      "sC": ""
    },
    {
      "line": "para cumplir tu voluntad, (Sol,,0)(La,m,205)",
      "sC": ""
    },
    {
      "line": "y adquirir para Ti un pueblo santo. ",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Él,",
      "sC": "asterisco"
    },
    {
      "line": "extendió sus brazos en la cruz,, (Sol,,60)(La,m,265)",
      "sC": ""
    },
    {
      "line": "muriendo destruyó la muerte.,(Sol,,25)(La,m,220) ",
      "sC": ""
    },
    {
      "line": "Y proclamó, ",
      "sC": ""
    },
    {
      "line": "la resurrección.,(Sol,,0)(La,m,115) ",
      "sC": ""
    },
    {
      "line": "Y PROCLAMÓ, (La,m,0)",
      "sC": "as r1"
    },
    {
      "line": "LA RESURRECCIÓN., (Sol,,0)(La,m,115)",
      "sC": "as"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Por este misterio de salvación,, (La,m,0)",
      "sC": ""
    },
    {
      "line": "unidos a los ángeles y a los santos, ",
      "sC": ""
    },
    {
      "line": "cantamos a una sola voz, (Sol,,0)",
      "sC": ""
    },
    {
      "line": "el himno de tu gloria:, (La,m,155)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
