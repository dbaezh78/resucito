  "lizq": [
    {
      "line": "Alma de Cristo, santifícame (Re,,0)(Si,m,110)(Sol,,180)(La,,250)(Re,,320)",
      "sC": "tc"
    },
    {
      "line": "Cuerpo de Cristo, sálvame. (La,,0)(Si,m,120)(Sol,,200)(Re,,290)",
      "sC": ""
    },
    {
      "line": "Sangre de Cristo, embriágame. (La,,180)(Si,m,250)(La,,290)(Sol,,330)",
      "sC": ""
    },
    {
      "line": "Agua del costado de Cristo, lávame. (Re,,240)(La,,300)(Re,,350)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Pasión de Cristo, confórtame. (Mi,m,0)(Re,,120)(Mi,m,200)(Re,,280)",
      "sC": ""
    },
    {
      "line": "¡Oh, buen Jesús!, óyeme. (Mi,m,0)(Re,,150)(Mi,m,210)(Re,7,260)",
      "sC": ""
    },
    {
      "line": "Y dentro de tus llagas, escóndeme. (Sol,,30)(Re,,180)(La,,250)(Si,m,320)",
      "sC": ""
    },
    {
      "line": "No permitas que me aparte de Ti. (La,,0)(Sol,,70)(Re,,210)(La,,300)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Del enemigo, defiéndeme. (Mi,m,0)(Re,,110)(Mi,m,190)(Re,,250)",
      "sC": ""
    },
    {
      "line": "En la hora de mi muerte, llámame. (Mi,m,30)(Re,,190)(Mi,m,250)(Re,,320)(Re,7,350)",
      "sC": ""
    },
    {
      "line": "Y mándame ir a Ti. (Sol,,30)(Re,,160)",
      "sC": ""
    },
    {
      "line": "Para con tus santos te alabe (La,,0)(Si,m,140)(Sol,,260)",
      "sC": ""
    },
    {
      "line": "Por los siglos de los siglos, Amén. (Re,,90)(La,,230)(Sol,,300)(Re,,340)",
      "sC": ""
    }
  ]
}