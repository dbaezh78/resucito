  "lizq": [
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Tantas cosas en la vida (La,m,0)(Re,m,130)",
      "sC": "tc"
    },
    {
      "line": "nos ofrecen plenitud, (Sol,,100)",
      "sC": ""
    },
    {
      "line": "y no son más que mentiras (Do,,0)(Mi,,120)",
      "sC": ""
    },
    {
      "line": "que desgastan la inquietud. (La,m,120)",
      "sC": ""
    },
    {
      "line": "Tú has llenado mi existencia (Re,m,130)",
      "sC": ""
    },
    {
      "line": "al quererme de verdad. (Fa,,100)(Mi,,140)",
      "sC": ""
    },
    {
      "line": "Yo quisiera, Madre buena, amarte más. (La,m,180)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "En silencio escuchabas (Re,m,130)",
      "sC": ""
    },
    {
      "line": "la palabra de Jesús, (Sol,,110)",
      "sC": ""
    },
    {
      "line": "y la hacías pan de vida (Do,,0)(Mi,,120)",
      "sC": ""
    },
    {
      "line": "meditando en tu interior. (La,m,120)",
      "sC": ""
    },
    {
      "line": "La semilla que ha caído (Re,m,130)",
      "sC": ""
    },
    {
      "line": "ya germina y está en flor. (Fa,,100)(Mi,,140)",
      "sC": ""
    },
    {
      "line": "Con el corazón en fiesta cantaré: ",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "AVE MARÍA, AVE MARÍA. (Do,,0)(Re,m,60)(Fa,,100)(Do,,130)(Sol,,160)",
      "sC": "ta as"
    },
    {
      "line": "AVE MARÍA, AVE MARÍA. (Do,,10)(Re,m,60)(Fa,,100)(Do,,130)(Sol,,160)(Do,,190)",
      "sC": "as"
    }
  ],
  "lder": [
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Desde que yo era un niño (La,m,0)",
      "sC": "tc"
    },
    {
      "line": "has estado junto a mí, ",
      "sC": ""
    },
    {
      "line": "y guiado de tu mano, ",
      "sC": ""
    },
    {
      "line": "aprendí a decir que sí. ",
      "sC": ""
    },
    {
      "line": "Al calor de la esperanza ",
      "sC": ""
    },
    {
      "line": "nunca se enfrió mi fe ",
      "sC": ""
    },
    {
      "line": "y en la noche más oscura fuiste luz. ",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "No me dejes, Madre mía, ",
      "sC": ""
    },
    {
      "line": "ven conmigo al caminar. ",
      "sC": ""
    },
    {
      "line": "Quiero compartir mi vida ",
      "sC": ""
    },
    {
      "line": "y crear fraternidad. ",
      "sC": ""
    },
    {
      "line": "Muchas cosas en nosotros ",
      "sC": ""
    },
    {
      "line": "son el fruto de tu amor. ",
      "sC": ""
    },
    {
      "line": "La plegaria más sencilla cantaré: ",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "AVE MARÍA, AVE MARÍA. (Do,,0)(Re,m,60)(Fa,,100)(Do,,130)(Sol,,160)",
      "sC": "ta as"
    },
    {
      "line": "AVE MARÍA, AVE MARÍA. (Do,,10)(Re,m,60)(Fa,,100)(Do,,130)(Sol,,160)(Do,,190)",
      "sC": "as"
    }
  ]
}