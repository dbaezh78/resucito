    },

    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Entrégate hermano al señor Jesús. (La,,0)(Fa#,m,290)",
      "sC": ""
    },
    {
      "line": "Él te ama, aunque seas pecador, (Re,,60)(Si,m,250)",
      "sC": ""
    },
    {
      "line": "El pagó el precio de tu salvación (La,,0)(Fa#,m,265)",
      "sC": ""
    },
    {
      "line": "Y ahora eres una nueva creación. (Re,,30)(Mi,,170)(La,,270)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
