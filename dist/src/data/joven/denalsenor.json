    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Dios dijo a Moisés: haz mi pueblo libre. (La,,0)(Fa#,m,340)",
      "sC": ""
    },
    {
      "line": "Yo seré tu guía, siempre sígueme. (La,,35)(Fa#,m,270)",
      "sC": ""
    },
    {
      "line": "Salidos ya de Egipto y el mar pasado (La,,30)(Fa#,m,320)",
      "sC": ""
    },
    {
      "line": "Cantaron y bailaron, se llenaron de júbilo. (Re,,30)(Mi,,135)(La,,295)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },

   {
