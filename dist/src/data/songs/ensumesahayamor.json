    },
    {
      "line": "EL SEÑOR NOS HA INVITADO A ESTAR CON ÉL. (Do,,10)(Fa,,120)(Sol,,230)",
      "sC": "as"
    },
    {
      "line": "EN SU MESA HAY AMOR, (Fa,,10)(Do,,130)",
      "sC": "as"
