    {
      "line": "LA PROMESA DEL PERDÓN, (Fa,,10)(Do,,140)",
      "sC": "as"
    },
    {
      "line": "Y EN EL VINO Y PAN, SU CORAZÓN. (Fa,,10)(Sol,,120)(Do,,190)(Do,7,220)",
