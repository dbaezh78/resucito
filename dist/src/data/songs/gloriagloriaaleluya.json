      "sC": ""
    },
    {
      "line": "será libre y tendrá paz. (Mi,,12)",
      "sC": ""
    },
    {
      "line": "Rompe pronto tus cadenas, (Mi,,12)",
      "sC": ""
    },
    {
      "line": "eres libre de verdad, (La,,12)",
      "sC": ""
    },
    {
      "line": "empieza a caminar. (La,,12)(Si,7,120)(Mi,,200)",
      "sC": ""
    }
