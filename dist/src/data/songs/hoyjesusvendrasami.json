  "lizq": [
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Mi casa está preparada (Sol,,0)(La,m,120)(Sol,,180)(La,m,230)",
      "sC": "tc"
    },
    {
      "line": "Para que vengas Jesús, (Sol,,0)(La,m,120)(Si,m,170)",
      "sC": ""
    },
    {
      "line": "Abrigo le da a un trozo de Pan, (Sol,7,0)(Do,,110)(Re,,160)(Sol,,210)(Mi,m,240)",
      "sC": ""
    },
    {
      "line": "Pan roto que ahora eres Tú. (La,m,0)(Re,,140)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Camino por esta vida (Sol,,0)(La,m,110)(Sol,,170)(La,m,220)",
      "sC": ""
    },
    {
      "line": "Sabiendo que estás en mí (Sol,,0)(La,m,110)(Si,m,170)",
      "sC": ""
    },
    {
      "line": "Y estamos los dos en un corazón (Do,,0)(Re,,80)(Sol,,150)(Mi,m,180)",
      "sC": ""
    },
    {
      "line": "Que se debe compartir. (La,m,0)(Re,,120)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "HOY JESÚS VENDRÁS A MÍ, (Do,,0)(Re,,60)(Mi,m,110)",
      "sC": "ta as"
    },
    {
      "line": "ME ILUMINARÁ TU LUZ. (Do,,10)(Re,,70)(Sol,,110)",
      "sC": "as"
    },
    {
      "line": "TÚ YA SABES CÓMO SOY (Do,,10)(Re,,70)",
      "sC": "as"
    },
    {
      "line": "LO QUE TENGO TE LO DOY. (Sol,,10)(Mi,m,70)",
      "sC": "as"
    },
    {
      "line": "HOY JESÚS ESTÁS EN MÍ. (Do,,10)(Re,,60)(Sol,,110)",
      "sC": "as"
    }
  ],
  "lder": [
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Mis ojos serán tus ojos (Sol,,0)(La,m,110)(Sol,,170)(La,m,220)",
      "sC": "tc"
    },
    {
      "line": "Que al mundo saben mirar. (Sol,,0)(La,m,110)(Si,m,170)",
      "sC": ""
    },
    {
      "line": "Mirar con amor, sentir su dolor. (Do,,0)(Re,,70)(Sol,,140)(Mi,m,170)",
      "sC": ""
    },
    {
      "line": "Mirada para curar. (La,m,0)(Re,,110)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Mis manos serán tus manos (Sol,,0)(La,m,110)(Sol,,170)(La,m,220)",
      "sC": ""
    },
    {
      "line": "Que abrazan y dan la paz, (Sol,,0)(La,m,110)(Si,m,170)",
      "sC": ""
    },
    {
      "line": "Dispuestas están para trabajar, (Do,,0)(Re,,80)(Sol,,150)(Mi,m,180)",
      "sC": ""
    },
    {
      "line": "Mis manos, para salvar. (La,m,0)(Re,,120)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Y te digo muy bajito: (Sol,,0)(La,m,110)(Sol,,170)(La,m,220)",
      "sC": ""
    },
    {
      "line": "Gracias por venir a mí. (Sol,,0)(La,m,100)(Si,m,160)",
      "sC": ""
    },
    {
      "line": "A veces, Señor, me pierde el temor, (Do,,0)(Re,,70)(Sol,,140)(Mi,m,170)",
      "sC": ""
    },
    {
      "line": "Y no sé por dónde ir. (La,m,0)(Re,,110)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "HOY JESÚS VENDRÁS A MÍ, (Do,,0)(Re,,60)(Mi,m,110)",
      "sC": "ta as"
    },
    {
      "line": "ME ILUMINARÁ TU LUZ. (Do,,10)(Re,,70)(Sol,,110)",
      "sC": "as"
    },
    {
      "line": "TÚ YA SABES CÓMO SOY (Do,,10)(Re,,70)",
      "sC": "as"
    },
    {
      "line": "LO QUE TENGO TE LO DOY. (Sol,,10)(Mi,m,70)",
