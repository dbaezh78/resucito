  "lizq": [
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Paz, Señor, en el cielo y la tierra, (Do,,0)(Sol,,160)",
      "sC": "tc"
    },
    {
      "line": "paz, Señor, en las olas del mar, (La,m,0)(Mi,m,160)",
      "sC": ""
    },
    {
      "line": "paz, Señor en las flores que mueve (Fa,,0)(Do,,160)",
      "sC": ""
    },
    {
      "line": "sin saberlo la brisa al pasar. (Re,,0)(Sol,,150)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Tú que has hecho las cosas tan bellas (Do,,0)(Sol,,160)",
      "sC": ""
    },
    {
      "line": "y les das una vida fugaz, (La,m,0)(Mi,m,150)",
      "sC": ""
    },
    {
      "line": "pon, Señor, tu mirada sobre ellas (Fa,,0)(Do,,160)",
      "sC": ""
    },
    {
      "line": "y devuelve a los hombres la paz. (Re,,0)(Sol,,150)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "PAZ, PAZ, PAZ, SEÑOR, (Do,,0)(Sol,,40)(La,m,80)(Mi,m,120)",
      "sC": "ta as"
    },
    {
      "line": "PAZ, PAZ, PAZ Y AMOR. (Fa,,10)(Do,,50)(Re,,90)(Sol,7,130)(Sol,,160)",
      "sC": "as"
    },
    {
      "line": "(BIS)",
      "sC": "as"
    }
  ],
  "lder": [
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Hoy he visto volar sobre el cielo (Do,,0)(Sol,,160)",
      "sC": "tc"
    },
    {
      "line": "suspendidas de un rayo de luz (La,m,0)(Mi,m,150)",
      "sC": ""
    },
    {
      "line": "dos palomas que alzaron el vuelo (Fa,,0)(Do,,160)",
      "sC": ""
    },
    {
      "line": "con sus alas en forma de cruz. (Re,,0)(Sol,,150)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Haz que vuelvan de nuevo a la tierra (Do,,0)(Sol,,160)",
      "sC": ""
    },
    {
      "line": "las palomas que huyeron, Señor, (La,m,0)(Mi,m,150)",
      "sC": ""
    },
    {
      "line": "y la llama que enciende la guerra (Fa,,0)(Do,,160)",
      "sC": ""
    },
    {
      "line": "se transforme en la Paz y el Amor. (Re,,0)(Sol,,160)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "PAZ, PAZ, PAZ, SEÑOR, (Do,,0)(Sol,,40)(La,m,80)(Mi,m,120)",
      "sC": "ta as"
    },
    {
      "line": "PAZ, PAZ, PAZ Y AMOR. (Fa,,10)(Do,,50)(Re,,90)(Sol,7,130)(Sol,,160)",
      "sC": "as"
    }
  ]
}