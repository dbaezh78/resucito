  "lizq": [
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Señor, toma mi vida nueva (Mi,,0)(La,,180)",
      "sC": "tc"
    },
    {
      "line": "Antes de que la espera, (Mi,,140)",
      "sC": ""
    },
    {
      "line": "Desgaste años en mí. (Si,7,140)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Estoy dispuesto a lo que quieras, (Mi,,0)(La,,200)",
      "sC": ""
    },
    {
      "line": "No importa lo que sea. (Mi,,140)",
      "sC": ""
    },
    {
      "line": "Tu llámame a servir. (La,,10)(Si,7,80)(Mi,,140)(Si,7,190)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "LLÉVAME DONDE LOS HOMBRES (Mi,,0)(Si,7,180)",
      "sC": "ta as"
    },
    {
      "line": "NECESITEN TUS PALABRAS, (La,,10)",
      "sC": "as"
    },
    {
      "line": "NECESITEN MIS GANAS DE VIVIR. (Mi,,10)(Si,7,180)",
      "sC": "as"
    },
    {
      "line": "DONDE FALTE LA ESPERANZA, (Mi,,10)(Si,7,180)",
      "sC": "as"
    },
    {
      "line": "DONDE FALTE LA ALEGRÍA, (La,,10)",
      "sC": "as"
    },
    {
      "line": "SIMPLEMENTE POR NO SABER DE TI. (Mi,,10)(La,,80)(Si,7,140)(Mi,,220)",
      "sC": "as"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Te doy mi corazón sincero (Mi,,0)(La,,180)",
      "sC": "tc"
    },
    {
      "line": "Para gritar sin miedo, (Mi,,140)",
      "sC": ""
    },
    {
      "line": "lo bello que es tu amor. (Si,7,140)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Tendré mis manos sin cansancio, (Mi,,0)(La,,190)",
      "sC": ""
    },
    {
      "line": "Tu historia entre mis labios (Mi,,140)",
      "sC": ""
    },
    {
      "line": "Y fuerza en la oración. (La,,10)(Si,7,80)(Mi,,140)(Si,7,190)",
      "sC": ""
    }
  ],
