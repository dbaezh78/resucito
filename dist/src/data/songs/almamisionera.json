    {"line": "Señor, toma mi vida nueva, (Sol,,0)(Re,,70)","sC": "tc"},
    {"line": "antes de que la espera (Mi,m,0)","sC": ""},
    {"line": "desgaste años en mí. (Si,m,0)","sC": ""},

    {"line": "","sC": "adb1"},

    {"line": "Estoy, dispuesto a lo que quieras, (Do,,0)(Sol,,70)","sC": ""},
    {"line": "no importa lo que sea, (La,m,0)","sC": ""},
    {"line": "Tú llámame a servir. (Re,,0)","sC": ""},

    {"line": "","sC": "adb1"},

    {"line": "LLÉVAME DONDE LOS HOMBRES, (Sol,,0)","sC": "ta as"},
    {"line": "NECESITEN TUS PALABRAS, (Si,m,0)","sC": "as"},

    {"line": "","sC": "adb1"},

