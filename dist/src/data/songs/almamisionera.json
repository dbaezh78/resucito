    {"line": "","sC": "adb1"},

    {"line": "DONDE FALTE LA ALEGRÍA, SIMPLEMENTE,, (Si,m,0)(Do,,240)","sC": "as"},
    {"line": "POR NO SABER DE TI. (Re,,0)(Sol,,160)","sC": "as"},

    {"line": "","sC": "adb1"},

    {"line": "Te doy Mi corazón sincero, (Sol,,0)(Re,,70)","sC": "tc"},
    {"line": "Para gritar sin miedo, (Mi,m,0)","sC": ""},
    {"line": "Lo hermoso que es Tu amor. (Si,m,0)","sC": ""},

    {"line": "","sC": "adb1"},

