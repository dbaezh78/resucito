  "lizq": [
    {
      "line": "Oh Dios, (Mi,m,0)",
      "sC": "pa asterisco"
    },
    {
      "line": "que por medio de los signos sacramentales, (La,m,20)(Si,7,384)",
      "sC": ""
    },
    {
      "line": "tú obras con invisible potencia, ",
      "sC": ""
    },
    {
      "line": "las maravillas de la salvación., (Mi,m,262)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "mheight0"
    },
    {
      "line": "De muchos modos, ",
      "sC": "asterisco"
    },
    {
      "line": "a través de los tiempos, (La,m,0)",
      "sC": ""
    },
    {
      "line": "has preparado el agua, tu criatura,, (Do,,10)",
      "sC": ""
    },
    {
      "line": "para que fuese signo del Bautismo., (Si,7,275)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Desde los orígenes tu Espíritu, (Mi,m,0)",
      "sC": "asterisco"
    },
    {
      "line": "aleteaba sobre las aguas,,(La,m,20)(Si,7,185) ",
      "sC": ""
    },
    {
      "line": "para que contuviesen la fuerza de santificar. ",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Y también en el Diluvio, (Mi,m,20)",
      "sC": "asterisco"
    },
    {
      "line": "has prefigurado el Bautismo,,(La,m,20)(Si,7,230)",
      "sC": ""
    },
    {
      "line": "para que hoy como ayer, (Mi,m,185)",
      "sC": ""
    },
    {
      "line": "el agua señalase el fin del pecado, (Re,,30)(Do,,195)",
      "sC": ""
    },
    {
      "line": "y el inicio de la Vida Nueva.,  (Si,7,240)",
      "sC": ""
    },
    {
      "line": "Tú, has liberado de la esclavitud, (Mi,m,240)",
      "sC": ""
    },
    {
      "line": "a los hijos de Abraham, (Re,,195)",
      "sC": ""
    },
    {
      "line": "haciéndoles pasar ilesos el Mar Rojo,(Mi,m,320) ",
      "sC": ""
    },
    {
      "line": "para que fuesen la imagen, ",
      "sC": ""
    },
    {
      "line": "del futuro pueblo de bautizados., (Re,,125)(Mi,m,250)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Por fin, en la plenitud de los tiempos,, (Re,,320)",
      "sC": ""
    },
    {
      "line": "tu Hijo, bautizado en el agua del Jordán,, (Mi,m,25)(Re,,380)",
      "sC": ""
    },
    {
      "line": "fue consagrado por el Espíritu Santo., (Do,,100)(Si,7,310)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "LEVANTADO EN LA CRUZ,, (Mi,m,0)(Re,,175)",
      "sC": "pa as"
    },
    {
      "line": "DE SU COSTADO SALIÓ, (Do,,170)",
      "sC": "as r1"
    },
    {
      "line": "SANGRE Y AGUA., (Si,7,90)",
      "sC": "as"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Y después de su resurrección, (Mi,m,0)(Re,,250)",
      "sC": "pa"
    },
    {
      "line": "ordenó a sus discípulos:, (Mi,m,155)",
      "sC": ""
    },
    {
      "line": "«Id y anunciad el Evangelio, (Re,,225)",
      "sC": ""
    },
    {
      "line": "a todos los pueblos,, (Mi,m,125)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "BAUTIZÁNDOLOS, (Mi,m,0)",
      "sC": "pa as bisa hbis180 lbis331 tbis10"
    },
    {
      "line": "EN EL NOMBRE DEL PADRE,, (Re,,180)",
      "sC": "ta as"
    },
    {
      "line": "Y DEL HIJO,, (Do,,65)",
      "sC": "as"
    },
    {
      "line": "Y DEL ESPÍRITU SANTO., (Si,7,160)",
      "sC": "as"
    }
  ],
  "lder": [
    {
      "line": "Ahora, ahora Padre,, (Mi,m,0)",
      "sC": "pa"
    },
    {
      "line": "mira con amor a tu Iglesia, (Re,,210)",
      "sC": ""
    },
    {
      "line": "y haz brotar para ella, (Do,,175)",
      "sC": ""
    },
    {
      "line": "la fuente del Bautismo., (Si,7,165)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Infunde en esta agua,, (Mi,m,0)(Re,,160)",
      "sC": ""
    },
    {
      "line": "por obra del Espíritu Santo,, (Do,,220)",
      "sC": ""
    },
    {
      "line": "la gracia de tu Único Hijo,, (Si,7,215)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "para que por el Sacramento del Bautismo, (Mi,m,50)(Re,,340)",
      "sC": ""
    },
    {
      "line": "el hombre, hecho a tu imagen,, (Mi,m,235)",
      "sC": ""
    },
    {
      "line": "sea lavado de todos sus pecados, (Re,,265)",
      "sC": ""
    },
    {
      "line": "y del agua y del Espíritu Santo, (Do,,265)",
      "sC": ""
    },
    {
      "line": "renazca como nueva criatura., (Si,7,230)",
      "sC": ""
    },
    {
      "line": "Descienda, Padre,, (Mi,m,0)",
      "sC": "asterisco"
    },
    {
      "line": "en esta agua, por obra de tu Hijo,, (La,m,0)(Si,7,290)",
      "sC": ""
    },
    {
      "line": "la potencia del Espíritu Santo., (Mi,m,250)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Para que todos aquellos que hoy reciban, ",
      "sC": ""
    },
    {
      "line": "el Bautismo, sean sepultados con Cristo., (Re,,60)(Mi,m,335)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
