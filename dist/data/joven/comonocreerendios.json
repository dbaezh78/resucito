    {
      "line": "Yo te llevo, desde niño muy adentro,, (Mi,m,0)(Si,7,9)(Mi,m,32)",
      "sC": ""
    },
    {
      "line": "te encontraba en el pajaro y la flor,, (Sol,,8)(Re,,20)(Sol,,32)",
      "sC": ""
    },
    {
      "line": "en la lluvia, en la tierra y el silencio,, (Si,7,7)(Mi,m,36)",
      "sC": ""
    },
    {
      "line": "y en mis sueños cada noche estabas tu., (La,m,10)(Si,7,21)(Mi,m,35)",
      "sC": ""
    },
    {
      "line": "Desde entonces quiero darte siempre gracias,, (Mi,m,7)(Si,7,10)(Mi,m,35)",
      "sC": ""
    },
    {
      "line": "por que puedo darme cuenta de tu amor,, (Sol,,8)(Re,,20)(Sol,,33)",
      "sC": ""
    },
    {
      "line": "beberé de tu cuerpo y de tu sangre,, (Si,7,3)(Mi,m,28)",
      "sC": ""
    },
    {
      "line": "y por siempre te dare...... mi corazon., (La,m,7)(Si,7,18)(Mi,,35)",
      "sC": ""
