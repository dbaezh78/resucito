      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Regina caeli, laetare, alleluia. (Re,,0)(Sol,,90)(La,,150)(Si,m,200)",
      "sC": "tc"
    },
    {
      "line": "Quia quem meruisti portare, alleluia. (Re,,0)(Sol,,80)(Si,m,150)(Mi,m,210)(La,7,250)(Re,,280)",
      "sC": ""
    },
    {
      "line": "Resurrexit, sicut dixit, alleluia. (Re,,0)(Sol,,60)(Re,,90)(Si,m,130)(Re,,180)(La,7,230)",
      "sC": ""
    },
    {
      "line": "Ora pro nobis Deum, alleluia. (Mi,m,0)(La,7,60)(Si,m,120)(Mi,m,160)(La,7,190)(Re,,230)",
      "sC": ""
    }
  ],
  "lder": [
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Traducción:",
      "sC": "tc"
    },
    {
      "line": "V. Reina del cielo, alégrate. ",
      "sC": ""
    },
    {
      "line": "R. Aleluya. ",
      "sC": ""
    },
    {
      "line": "V. Porque el Señor, a quien mereciste llevar. ",
      "sC": ""
    },
    {
      "line": "R. Aleluya. ",
      "sC": ""
    },
    {
      "line": "V. Ha resucitado, como lo había dicho. ",
      "sC": ""
    },
    {
      "line": "R. Aleluya. ",
      "sC": ""
    },
    {
      "line": "V. Ruega al Señor por nosotros. ",
      "sC": ""
    },
    {
      "line": "R. Aleluya. ",
      "sC": ""
    },
    {
      "line": "V. Goza y alégrate, Virgen María. Aleluya. ",
      "sC": ""
    },
    {
      "line": "R. Porque verdaderamente ha resucitado el Señor. Aleluya. ",
      "sC": ""
    }
  ]
