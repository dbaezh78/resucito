        },
        {
          "line": "MISERICORDIA MÍA, MISERICORDIA (Mi,m,0)(Re,,210)(Mi,m,240)",
          "sC": "as"
        }
      ]
    },
    {
      "line": "",
      "sC": "adb1 junte"
    },
    {
      "line": "Devuélveme la alegría de tu salvación, (Mi,m,0)(La,m,330)",
      "sC": "junte"
    },
    {
      "line": "afiánzame con espíritu generoso; (Mi,m,235)",
      "sC": "junte"
    },
    {
      "line": "enseñaré a los malvados tus caminos, (La,m,295)",
      "sC": "junte"
    },
    {
      "line": "los pecadores volverán a ti., (Mi,m,220)",
      "sC": "junte"
    },
    {
      "line": "",
      "sC": "adb1 junte"
    },
    {
      "type": "collapsible-block",
      "id": "asamblea_anadie_7",
      "initialState": "collapsed",
      "triggerLine": "MISERICORDIA MÍA (Mi,m,0)",
      "sC": "ta as zindex",
      "lines": [
        {
          "line": "MISERICORDIA MÍA, MISERICORDIA (Mi,m,0)(Re,,210)(Mi,m,240)",
          "sC": "as sub"
