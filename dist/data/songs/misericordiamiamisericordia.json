      "lines": [
        {
          "line": "MISERICORDIA MÍA, MISERICORDIA (Mi,m,0)(Re,,210)(Mi,m,240)",
          "sC": "as sub"
        },
        {
          "line": "MISERICORDIA MÍA, MISERICORDIA (Mi,m,0)(Re,,210)(Mi,m,240)",
          "sC": "as"
        }
      ]
    },
    {
      "line": "",
      "sC": "adb1 junte"
    },
    {
      "line": "Hazme oír el gozo y la alegría, (Mi,m,0)(La,m,255)",
      "sC": "junte"
    },
    {
      "line": "que se alegren los huesos quebrantados., (Mi,m,285)",
      "sC": "junte"
    },
    {
      "line": "Aparta de mi pecado tu vista, (La,m,230)",
      "sC": "junte"
    },
    {
      "line": "borra en mí toda culpa., (Mi,m,180)",
      "sC": "junte"
    },
    {
      "line": "",
      "sC": "adb1 junte"
    },
    {
      "type": "collapsible-block",
      "id": "asamblea_anadie_5",
      "initialState": "collapsed",
      "triggerLine": "MISERICORDIA MÍA (Mi,m,0)",
