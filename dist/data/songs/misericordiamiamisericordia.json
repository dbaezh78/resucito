  "lizq": [
    {
      "line": "MISERICORDIA MÍA, MISERICORDIA… (Mi,m,0)(Re,,210)(Mi,m,240)",
      "sC": "tc as bisa hbis50 lbis411"
    },
    
    {
      "line": "Misericordia, Dios mío, por tu bondad, (Mi,m,0)(La,m,340)",
      "sC": "tc"
    },
    {
      "line": "por tu inmensa compasión borra mi culpa; (Mi,m,335)",
      "sC": ""
    },
    {
      "line": "lava del todo mi delito,, (La,m,185)",
      "sC": ""
    },
    {
      "line": "limpia mi pecado. (Mi,m,115)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "type": "collapsible-block",
      "id": "asamblea_anadie_1",
