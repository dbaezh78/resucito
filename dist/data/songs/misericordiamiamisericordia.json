        }
      ]
    },
    {
      "line": "",
      "sC": "adb1 junte"
    }
  ],
  "lder": [
    {
      "line": "Oh Dios, crea en mí un corazón puro, (Mi,m,0)(La,m,315)",
      "sC": "junte"
    },
    {
      "line": "renuévame por dentro con espíritu firme; (Mi,m,345)",
      "sC": "junte"
    },
    {
      "line": "no me arrojes lejos de tu rostro, (La,m,280)",
      "sC": "junte"
    },
    {
      "line": "no me quites tu Santo Espíritu. (Mi,m,235)",
      "sC": "junte"
    },
    {
      "line": "",
      "sC": "adb1 junte"
    },
    {
      "type": "collapsible-block",
      "id": "asamblea_anadie_6",
      "initialState": "collapsed",
      "triggerLine": "MISERICORDIA MÍA (Mi,m,0)",
      "sC": "ta as zindex",
      "lines": [
        {
          "line": "MISERICORDIA MÍA, MISERICORDIA (Mi,m,0)(Re,,210)(Mi,m,240)",
