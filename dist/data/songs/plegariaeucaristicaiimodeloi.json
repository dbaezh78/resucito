    {"line": "Relato de la Institución,","sC": "ttgray","color": "var(--Referencia-Texto)"},


    {"line": "El cual, cuando iba a ser entregado a su Pasión,, (Re,m,0)","sC": "pa"},
    {"line": "voluntariamente aceptada, tomó el pan,, ","sC": ""},
    {"line": "y elevando los ojos a Ti, Padre, Padre,, ","sC": ""},
    {"line": "pronunció la bendición,, (Fa,,0)","sC": ""},
    {"line": "lo partió y lo dio a sus discípulos, diciendo:, (Sol,m,50)(Re,m,390)","sC": ""},
    {"line": "Tomad y comed todos de él,, (La,7,220)","sC": ""},
    {"line": "porque esto es mi Cuerpo,, (Re,m,65)","sC": ""},
    {"line": "que será entregado por vosotros., (La,7,140)(Re,m,250)","sC": ""},

    {"line": "","sC": ""},

    {"line": "Del mismo modo, acabada la cena,, (Re,m,0)","sC": ""},
    {"line": "tomó el cáliz, lleno del fruto de la vid,, ","sC": ""},
    {"line": "y elevando los ojos a Ti, Padre, Padre,, ","sC": ""},
    {"line": "pronunció la bendición,, (Fa,,0)","sC": ""},
    {"line": "lo pasó a sus discípulos, diciendo:, (Sol,m,50)(Re,m,280)","sC": ""},
    {"line": "Tomad y bebed todos de él,, (La,7,220)","sC": ""},
    {"line": "porque este es el cáliz de mi Sangre,, (Re,m,65)","sC": ""},
