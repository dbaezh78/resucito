    {"line": "Prefacio*","sC": "ttgray","color": "var(--Referencia-Texto)"},


    {"line": "El Señor esté con vosotros., (Sol,,0)(La,m,200)","sC": "pa"},
    {"line": "Y CON TU ESPÍRITU., (Sol,,0)(La ,m,110)","sC": "ta"},
    {"line": "Levantemos el corazón., (Fa,,0)(Mi,,185)","sC": "pa"},
    {"line": "LO TENEMOS LEVANTADO HACIA EL SEÑOR., (Fa,,0)(Mi,,330)","sC": "as"},
    {"line": "Demos gracias al Señor, nuestro Dios., (La ,m,320)","sC": "ta"},
    {"line": "A ES JUSTO Y NECESARIO., (Sol,,50)(La ,m,170)","sC": "pa as bisa hbis30 lbis320 tbis10"},

    {"line": "","sC": ""},
    
    {"line": "En verdad es justo y necesario,, (La ,m,0)(Sol,,250)","sC": "pa"},
    {"line": "es nuestro deber y salvación, (La ,m,240)","sC": ""},
    {"line": "darte gracias,, (Do,,75)","sC": ""},
    {"line": "siempre y en todo lugar,, (La ,m,200)","sC": ""},
    {"line": "a ti, Padre Santo,, (Sol,,10)","sC": ""},
    {"line": "por Jesucristo, tu Hijo amado., (La ,m,255)","sC": ""},

    {"line": "","sC": ""},

    {"line": "Por Él, que es tu Palabra,, (Sol,,200)","sC": ""},
    {"line": "hiciste todas las cosas., (La ,m,175)","sC": ""},
    {"line": "Tú nos lo enviaste hecho hombre, (Do,,130)","sC": ""},
    {"line": "por obra del Espíritu Santo,, (La ,m,220)","sC": ""},
    {"line": "para que, nacido de María la Virgen,, (Sol,,295)","sC": ""},
    {"line": "fuera nuestro Salvador y Redentor., (La ,m,270)","sC": ""},
    {"line": "Él, en cumplimiento de tu voluntad,, (Fa,,0)(Mi,,320)","sC": ""},

    {"line": "para destruir la muerte, (Fa,,15)","sC": ""},
    {"line": "y manifestar la resurrección,, (Mi,,247)","sC": ""},
    {"line": "extendió sus brazos en la cruz,, (La,m,60)(Sol,,270)","sC": ""},
    {"line": "y así adquirió para ti, (Fa,,200)","sC": ""},
    {"line": "un pueblo santo., (Mi,7,100)","sC": ""},

