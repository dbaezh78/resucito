    {
      "line": "Había un hombre llamado Zaqueo,, (La,m,0)",
      "sC": "tc"
    },
    {
      "line": "que era jefe de publicanos y muy rico, (Sol,,325)",
      "sC": ""
    },
    {
      "line": "que trataba de ver a Jesús, pero no podía, (Fa,,235)",
      "sC": ""
    },
    {
      "line": "porque era de pequeña estatura., (Mi,,265)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Se adelantó corriendo, (La,m,0)",
      "sC": ""
    },
    {
      "line": "y se subió a un sicómoro,, (Sol,,175)",
      "sC": ""
    },
    {
      "line": "pues iba a pasar por allí,, (Fa,,45)",
      "sC": ""
    },
    {
      "line": "pues iba a pasar por allí., (Mi,,220)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Cuando llegó Jesús,, (La,m,0)",
      "sC": ""
    },
    {
      "line": "alzó la vista y le vio,, (Sol,,190)",
      "sC": ""
    },
    {
      "line": "y le dijo: «Zaqueo, baja pronto;, (Fa,,0)",
      "sC": ""
    },
    {
      "line": "porque conviene que hoy yo entre en tu casa,, (Mi,,395)",
      "sC": ""
    },
    {
      "line": "conviene que yo entre en tu casa»., (Fa,,35)(Mi,,280)",
      "sC": ""
    },
