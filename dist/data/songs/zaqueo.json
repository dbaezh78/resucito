  "lder": [
    {
      "line": "Bajó deprisa Zaqueo, (La,m,0)",
      "sC": "tc"
    },
    {
      "line": "y le recibió lleno de alegría., (Sol,,250)",
      "sC": ""
    },
    {
      "line": "Al verlo, todos murmuraban:, (Fa,,210)",
      "sC": ""
    },
    {
      "line": "«Ha entrado en casa de un pecador»., (Mi,,305)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Zaqueo, se puso en pie y dijo al Señor:, (La,m,0)",
      "sC": ""
    },
    {
      "line": "«Daré, Señor, la mitad de mis bienes a los pobres;, (Sol,,430)",
      "sC": "ajustar"
    },
    {
      "line": "y si en algo defraudé, el cuádruplo le devolveré»., (Fa,,75)(Mi,,460)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Y Jesús le dijo:, (La,m,0)",
      "sC": ""
    },
    {
      "line": "Hoy ha llegado la salvación a esta casa,, (La,m,0)(Sol,,350)",
      "sC": "tc"
    },
    {
      "line": "hoy ha llegado la salvación a esta casa., (Fa,,0)(Mi,,355)",
      "sC": ""
    },
    {
      "line": "HOY HA LLEGADO LA SALVACIÓN A ESTA CASA,, (La,m,0)(Sol,,350)",
      "sC": "ta as"
    },
    {
      "line": "HOY HA LLEGADO LA SALVACIÓN A ESTA CASA»., (Fa,,5)(Mi,,355)",
      "sC": "as"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
