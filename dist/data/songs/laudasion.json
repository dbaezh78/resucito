      "line": "nosotros lo renovamos. (Mi,,165)",
      "sC": ""
    },
    {
      "line": "Obedientes a su palabra, (La,m,0)(Re,m,170)",
      "sC": ""
    },
    {
      "line": "consagramos pan y vino, (La,m,175)",
      "sC": ""
    },
    {
      "line": "¡Hostia de la salvación!, (Mi,,20)",
      "sC": ""
    },
