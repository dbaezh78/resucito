    },
    {
      "line": "la nueva Pascua y nueva Ley, (La,m,230)",
      "sC": ""
    },
    {
      "line": "donde lo antiguo termina. (Mi,,120)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Lo antiguo se verá nuevo, (La,m,0)(Re,m,195)",
      "sC": ""
    },
    {
      "line": "la realidad a la sombra; (La,m,160)",
      "sC": ""
    },
    {
      "line": "¡Es todo luz, ya no hay tinieblas!, (Mi,,90)",
