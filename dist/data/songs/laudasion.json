  "lizq": [
    {
      "line": "Alaba, Sión, al Salvador,, (La,m,20)(Re,m,216)",
      "sC": "tc"
    },
    {
      "line": "Él es tu guía y tu Pastor., (La,m,208)",
      "sC": ""
    },
    {
      "line": "Alábalo con himnos y cantos., (Mi,,25)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "ESTE ES EL PAN DE LOS ÁNGELES,, (La,m,0)(Re,m,220)",
      "sC": "ta as"
    },
    {
      "line": "PAN DE LOS QUE HACEN CAMINO., (La,m,230)",
      "sC": "as"
    },
    {
      "line": "ESTE ES EL PAN DE LOS HIJOS., (Mi,,0)",
      "sC": "as"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Canta con todo fervor,, (La,m,20)(Re,m,190)",
      "sC": "tc"
    },
    {
      "line": "al pan vivo que da vida:, (La,m,193)",
      "sC": ""
    },
    {
      "line": "este es el tema del canto, (Mi,,204) ",
      "sC": ""
    },
    {
      "line": "y el objeto de alabanza.",
      "sC": ""
    },
    {
