  "lder": [

    {
      "line": "Tú no ves, tú no comprendes;, (La,m,0)(Re,m,200)",
      "sC": "tc"
    },
    {
      "line": "mas la fe te lo confirma, (La,m,185)",
      "sC": ""
    },
    {
      "line": "más allá de la razón., (Mi,,65)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Es signo lo que aparece,, (La,m,0)(Re,m,180)",
      "sC": ""
    },
    {
      "line": "y esconde un gran misterio,, (La,m,200)",
      "sC": ""
    },
    {
      "line": "una realidad sublime., (Mi,,95)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Comes carne, bebes sangre,, (La,m,0)(Re,m,185)",
      "sC": ""
