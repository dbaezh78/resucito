rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Colección de enlaces cortos (PÚBLICA)
    match /listasCompartidas/{idCorto} {
      allow read, create: if true; 
      allow update, delete: if false;
    }

    // 2. Colección de usuarios (PRIVADA - Sincroniza tonos, notas y posiciones personales)
    match /usuarios/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. Posiciones globales de acordes (Lectura pública, escritura solo para el administrador)
    match /global_positions/{cantoId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'dbaezh78@gmail.com';
    }

    // 4. Colección de usuarios registrados para Control de Acceso
    match /registered_users/{userDoc} {
      allow read, write: if request.auth != null;
    }

    // 5. Configuración de permisos y grupos del sistema (Lectura PÚBLICA para Invitados, escritura para Administrador/Autenticado)
    match /system_config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 6. Reglas para el registro de uso de la aplicación (Uso App)
    match /registro_uso/{deviceId} {
      allow read: if request.auth != null; 
      allow write: if true; 
    }

    // 7. Colección de Catequesis (Lectura pública para todos, escritura para usuarios autenticados)
    match /catequesis/{cantoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 8. Colección de Configuración general y Liturgia (Lectura pública, escritura para usuarios autenticados)
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 9. Colección de BITÁCORA (Permite registrar a cualquier usuario/cantor y leer según autenticación)
    match /bitacora/{logId} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.email == 'dbaezh78@gmail.com';
    }

    // 10. Colección de ASISTENCIA Y CHAT EN VIVO (Soporte WhatsApp Web)
    // - Los documentos principales son el encabezado del chat por usuario
    match /support_chats/{chatId} {
      allow read, write: if request.auth != null && (
        request.auth.token.email == 'dbaezh78@gmail.com' || 
        request.auth.uid == chatId || 
        (resource != null && resource.data.userId == request.auth.uid) ||
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );

      // Subcolección de mensajes del chat
      match /messages/{messageId} {
        allow read, write: if request.auth != null && (
          request.auth.token.email == 'dbaezh78@gmail.com' || 
          request.auth.uid == chatId
        );
      }
    }

    // 11. Guardar Registros de log en firebase
    match /app_logs/{docId} {
      allow read, write: if true; // o if request.auth != null;
    }

    // 12. Bloqueo por defecto para cualquier otra colección no especificada
    match /{document=**} {
      allow read, write: if false;
    }
    
  }
}
